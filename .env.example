# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 1. PUBLIC KEY (Google Maps JavaScript API & Places UI Kit):
# Loaded in the browser when the Google Maps JavaScript API script initializes.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# 2. BACKEND KEY (Google Maps Platform Web Services):
# Configured in Secrets as GOOGLE_WEATHER_API_KEY.
# Kept strictly secret on the server for Weather, Geocoding, and Places REST APIs.
# NEVER revealed to the browser or sent in client responses.
GOOGLE_WEATHER_API_KEY="YOUR_GOOGLE_WEATHER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by the environment.
APP_URL="MY_APP_URL"
